#!/usr/bin/env bash
# Open the minimal trajectory-preview window; the local workspace must be running.
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if ! "$ROOT/.venv/bin/python" -c 'import json,urllib.request; assert json.load(urllib.request.urlopen("http://127.0.0.1:8001/api/health",timeout=1))["app"] == "sawyer-operations"' 2>/dev/null; then
    echo 'Workspace is not running at http://127.0.0.1:8001. Start it first with ./sawyer-operations.' >&2
    exit 1
fi
exec "$ROOT/.venv/bin/python" -m sawyer_operations.browser "$@"
