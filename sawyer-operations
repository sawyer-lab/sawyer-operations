#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CONTROL="${SAWYER_CONTROL_DIR:-$(dirname "$ROOT")/sawyer-control}"
cd "$ROOT"
if [[ ! -x "$ROOT/.venv/bin/python" ]]; then
    /usr/bin/python3 -m venv "$ROOT/.venv"
fi
PYTHON="$ROOT/.venv/bin/python"
if ! "$PYTHON" -c 'import fastapi, uvicorn, grpc, websockets, sawyer_control' 2>/dev/null; then
    "$PYTHON" -m pip install -e "$CONTROL" -e "$ROOT"
fi
if "$PYTHON" -c 'import json,urllib.request; assert json.load(urllib.request.urlopen("http://127.0.0.1:8001/api/health",timeout=1))["app"] == "sawyer-operations"' 2>/dev/null; then
    echo 'Sawyer workspace is already running: http://127.0.0.1:8001'
    bash "$ROOT/open-workspace" >> "$ROOT/browser.log" 2>&1 &
    exit 0
fi
if [[ ! -d "$ROOT/web/node_modules" ]]; then
    (cd "$ROOT/web" && npm ci --no-audit --no-fund)
fi
(cd "$ROOT/web" && npm run build)
echo 'Sawyer workspace: http://127.0.0.1:8001'
bash "$ROOT/open-workspace" >> "$ROOT/browser.log" 2>&1 &
exec "$PYTHON" -m uvicorn sawyer_operations.server:app --host 127.0.0.1 --port 8001
